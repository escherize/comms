#!/bin/sh
# Everything that must pass before a commit, in the order that fails fastest.
# It exists because the three commands were typed by hand every time and
# `gofmt -l` was the one that got forgotten.
set -e

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
	echo "gofmt:"; echo "$unformatted" | sed 's/^/  /'
	echo "run: gofmt -w ."
	exit 1
fi

go vet ./...

# staticcheck catches what vet does not (dead code, misused stdlib). Pinned by
# module so `go run` fetches the same version everywhere, CI included; skipped
# only when the network is down, so a plane ride still runs the rest.
if ! go run honnef.co/go/tools/cmd/staticcheck@v0.7.0 ./...; then
	echo "staticcheck failed"
	exit 1
fi

go test ./... -timeout 300s
echo "ok — formatted, vetted, staticchecked, tested"
